{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a '# renovate:' comment",
      "managerFilePatterns": [
        "/(^|/)\\.woodpecker/[^/]+\\.ya?ml$/",
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\s+(ARG |ENV )?[A-Z_]+[:=] ?\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Generated stubs must match the grpcio runtime",
      "matchPackageNames": [
        "grpcio",
        "grpcio-tools"
      ],
      "groupName": "grpc"
    },
    {
      "description": "jellyfin-ffmpeg: stay on 7.x (the image installs jellyfin-ffmpeg7; 8.x targets unreleased Jellyfin versions) and automerge once the PR test build passes; the merge is released automatically (.woodpecker/auto_release.yaml)",
      "matchPackageNames": [
        "jellyfin/jellyfin-ffmpeg"
      ],
      "allowedVersions": "<8",
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "6 hours"
    }
  ]
}
