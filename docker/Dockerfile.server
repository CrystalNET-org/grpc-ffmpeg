# renovate: datasource=github-releases depName=jellyfin/jellyfin-ffmpeg versioning=loose extractVersion=^v(?<version>.*)$
ARG JELLYFIN_FFMPEG_VERSION=8.1.3-1
# Checksum of that version's .deb, updated with it by scripts/update-ffmpeg-checksum.sh
ARG JELLYFIN_FFMPEG_SHA256=fbef9f81a53e175194e3f67832618a86111f7bd37197df21a5d748c34289f9c0

FROM debian:trixie-slim AS builder

# set our working directory within the build context
WORKDIR /app

# install needed build-time dependencies (grpcio-tools bundles protoc)
RUN apt-get update && apt-get install --no-install-recommends -y \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# The worker's Python dependencies, in a virtual environment copied to the final
# image, which then needs no pip (same Debian release, so the same Python)
COPY requirements.txt .
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt && \
    /opt/venv/bin/pip uninstall -y pip

# compile the .proto-file for later use from within python
COPY requirements-build.txt .
RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements-build.txt
COPY src/proto/ffmpeg.proto .
RUN python3 -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. ffmpeg.proto

# Final stage
FROM debian:trixie-slim
ARG JELLYFIN_FFMPEG_VERSION
ARG JELLYFIN_FFMPEG_SHA256

# Enable non-free repositories
RUN sed -i 's/Components: main/Components: main contrib non-free/' /etc/apt/sources.list.d/debian.sources

# Install packages that are needed for the runtime environment, plus jellyfin's
# fork of ffmpeg which comes with additional codecs and improved hw acceleration
# routines. Installing the .deb through apt resolves any missing dependencies.
# The package name contains the major version (jellyfin-ffmpeg8 for 8.x).
RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates wget && \
    wget -q -O /tmp/jellyfin-ffmpeg.deb \
        "https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v${JELLYFIN_FFMPEG_VERSION}/jellyfin-ffmpeg${JELLYFIN_FFMPEG_VERSION%%.*}_${JELLYFIN_FFMPEG_VERSION}-trixie_amd64.deb" && \
    echo "${JELLYFIN_FFMPEG_SHA256}  /tmp/jellyfin-ffmpeg.deb" | sha256sum -c - && \
    apt-get install --no-install-recommends -y \
        /tmp/jellyfin-ffmpeg.deb \
        libssl3t64 \
        libc-bin \
        python3 \
        intel-media-va-driver-non-free \
        i965-va-driver \
        nvidia-vaapi-driver \
        ocl-icd-libopencl1 \
        libbluray2 \
        libllvm17t64 \
        mediainfo \
        libmp3lame0 \
        libopenmpt0t64 \
        libvpx9 \
        libwebp7 \
        libwebpmux3 \
        libx264-164 \
        libx265-215 \
        libzvbi0t64 \
        libopus0 \
        libtheora0 \
        libvorbisenc2 && \
    rm -f /tmp/jellyfin-ffmpeg.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# The worker's Python dependencies, built in the first stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

# Copy the build artifact from the build stage
COPY /src/server/ /app/

COPY --from=builder /app/ffmpeg* /app/

RUN chmod a+x /app/grpc-ffmpeg.py

# Fail the build, not the worker, if the copied environment is broken
RUN cd /app && python3 -c "import grpc, aiohttp, prometheus_client, ffmpeg_pb2_grpc; from pymediainfo import MediaInfo; assert MediaInfo.can_parse()" && \
    ! command -v pip3

# Expose the port the service runs on
EXPOSE 50051 8080

# Set environment variables for Intel and Nvidia hardware acceleration
ENV LIBVA_DRIVER_NAME=iHD
ENV LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
ENV PYTHONUNBUFFERED=1

LABEL org.opencontainers.image.source=https://github.com/CrystalNET-org/grpc-ffmpeg
LABEL org.opencontainers.image.description="ffmpeg-worker"
LABEL org.opencontainers.image.licenses=GPL-3.0

# Used by docker / docker compose; kubernetes uses its own probes
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=4)"

# Run the binary
CMD ["/app/grpc-ffmpeg.py"]
