FROM debian:trixie-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install --no-install-recommends -y \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Compile the .proto file for Python (grpcio-tools bundles protoc)
COPY requirements-build.txt .
RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements-build.txt
COPY src/proto/ffmpeg.proto .
RUN python3 -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. ffmpeg.proto

# Final stage
FROM debian:trixie-slim

RUN apt-get update && apt-get install --no-install-recommends -y \
    ca-certificates \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /app/requirements.txt

COPY src/client/grpc-ffmpeg.py /app/
COPY --from=builder /app/ffmpeg* /app/

# The client runs whatever binary it is invoked as, so expose it under the
# names of the supported binaries.
RUN chmod a+x /app/grpc-ffmpeg.py && \
    for bin in ffmpeg ffprobe mediainfo vainfo; do ln -s /app/grpc-ffmpeg.py /usr/local/bin/$bin; done

ENTRYPOINT ["ffmpeg"]
CMD ["-version"]
